# Gemini API kaliti: https://aistudio.google.com/apikey dan oling
GEMINI_API_KEY=

# Asosiy model (tez va arzon) — yozish bosqichi uchun
GEMINI_MODEL=gemini-3.8-flash

# Strategiya va tahrir bosqichlari uchun "aqlliroq" model (bo'sh qolsa GEMINI_MODEL ishlatiladi).
# Pro modellar faqat pullik (Paid tier) kalitlarda ishlaydi, masalan: gemini-3.1-pro-preview
GEMINI_MODEL_SMART=

# Asosiy model band bo'lsa (503) yoki limit tugasa (429) navbat bilan sinaladigan zaxira modellar (vergul bilan)
GEMINI_MODEL_FALLBACK=gemini-3.7-flash,gemini-3.5-flash,gemini-flash-latest

# Ma'lumotlar bazasi fayli (loyiha papkasiga nisbatan)
DB_PATH=data/maryam.db

# ===== VERTEX AI (RECOMMENDED: Google Cloud billing va trial krediti bilan) =====
# Project ID: https://console.cloud.google.com/home/dashboard
GOOGLE_CLOUD_PROJECT_ID=project-990aebdb-5252-4043-862
# Vertex AI location
GOOGLE_CLOUD_LOCATION=us-central1
# Autentifikatsiya usuli:
#   1. gcloud auth application-default login  (macOS/Linux/WSL)
#   2. yoki GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Vertex AI'da ishlatiladigan model nomlari — bular Developer API'dagi
# (GEMINI_MODEL) nomlardan BOSHQACHA bo'lishi mumkin, chunki Vertex'ning
# "publisher model" katalogi alohida. Bo'sh qoldirsangiz, kod ichidagi
# standart (bir necha nomzodni ketma-ket sinaydigan) ro'yxat ishlatiladi.
VERTEX_MODEL=gemini-2.0-flash-001
VERTEX_MODEL_SMART=gemini-2.5-pro
VERTEX_MODEL_FALLBACK=gemini-2.5-flash,gemini-2.0-flash-001,gemini-1.5-flash-002,gemini-1.5-flash-001

# ===== TELEGRAM (ixtiyoriy — Copywriter natijasini botga yuborish) =====
# Bot yaratish: @BotFather'ga /newbot yozing, tokenni shu yerga qo'ying
TELEGRAM_BOT_TOKEN=
# Sizning shaxsiy chat ID'ingiz: botga /start bosgach,
# https://api.telegram.org/bot<TOKEN>/getUpdates orqali olinadi
TELEGRAM_CHAT_ID=
